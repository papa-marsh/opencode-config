{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "go",
    "model": "anthropic/claude-opus-5-5",
    "agents": {
        "build": {
            "hidden": true
        },
        "plan": {
            "hidden": true
        },
        "general": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        }
    },
    "policies": [
        {
            "action": "tool.use",
            "resource": "question:*",
            "effect": "deny"
        }
    ],
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "deny"
        }
    ]
}
