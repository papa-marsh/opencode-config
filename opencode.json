{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "go",
    "agent": {
        "build": {
            "hidden": true
        },
        "plan": {
            "hidden": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "model": "anthropic/claude-opus-5-5",
    "mcp": {},
    "policies": [
        {
            "action": "tool.use",
            "resource": "question:*",
            "effect": "deny"
        }
    ],
    "permission": {
        "*": "allow",
        "external_directory": {
            "*": "allow",
            "~/.ssh/**": "deny"
        }
    }
}
